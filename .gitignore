*.pyc
__pycache__/
.DS_Store
.vscode/
*.swp
node_modules/
*.zip

# Test runs: local reports and credentials never go to the repository
.env
.env.*
*.token
*_token
test-results/
playwright-report/
coverage/
# Visual tests: only the Linux reference screenshots (generated by CI) are
# versioned; captures made on Windows/macOS stay local
tests/visual/__screenshots__/**/*-win32.png
tests/visual/__screenshots__/**/*-darwin.png

# Tier B screenshots depend on the test instance and its HA version
tests/ha/e2e/__screenshots__/
